# 要執行的任務（對應 channels.json 的 key）
TASK=tvbs_news_summarize_tech

# AI provider 順序設定，依序輪詢
AI_PROVIDER_ORDER=gemini,deepseek

# Gemini API 設定
GEMINI_API_KEY=your-gemini-api-key

# DeepSeek API 設定
DEEPSEEK_API_KEY=your-deepseek-api-key

# LINE Bot 設定
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_TARGET_ID=your-line-user-or-group-id

# 本地測試用，預設 true
DRY_RUN=true